# Copy to .env if you want to change anything. Defaults already work.
# Inside Docker the emulator is reached by its service name "localstack", NOT localhost.
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
# Dummy credentials. The SDK demands some; Moto accepts anything.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PORT=3000
